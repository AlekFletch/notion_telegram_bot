# ---- Telegram ----
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456:AA...

# Кому разрешено писать боту (через запятую).
# Оставь пустым при первом запуске — бот ответит на /start твоим user_id,
# впиши его сюда и перезапусти. Пустое значение = режим настройки, пускает всех.
ALLOWED_USER_IDS=

# ---- Notion ----
# Internal Integration Secret с notion.so/my-integrations
NOTION_TOKEN=ntn_...
# База «Telegram Inbox»
NOTION_DATABASE_ID=78e306dd1b0e413db2eb26656e620ca4

# ---- Режим работы ----
# polling — для локального запуска; webhook — для Render
MODE=polling

# Только для MODE=webhook:
# Публичный адрес сервиса, без слэша на конце (Render подставит свой)
BASE_WEBHOOK_URL=
# Произвольная случайная строка: Telegram будет слать её в заголовке,
# чтобы никто посторонний не мог постучаться в твой вебхук
WEBHOOK_SECRET=
PORT=10000

# ---- Поведение ----
# Подтягивать текст статьи по ссылке из сообщения
FETCH_ARTICLES=true
# Максимальная длина извлечённой статьи, символов
ARTICLE_MAX_CHARS=40000
LOG_LEVEL=INFO

# ---- Архив видео ----
# Приватный канал, куда бот пересылает видео и всё, что не влезло в Notion.
# Пересылка не скачивает файл, поэтому лимит Bot API в 20 МБ не действует —
# так сохраняются ролики любого размера, а в заметке остаётся ссылка.
# Как узнать ID: создать канал → добавить бота администратором → написать
# в канале /id — бот ответит значением вида -100...
# Пусто или 0 — архив выключен, поведение как раньше.
ARCHIVE_CHAT_ID=
